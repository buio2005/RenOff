<Window x:Class="RenOff.App.PassphraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RenOff"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Window.Resources>
        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="AccentDialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
    </Window.Resources>
    <Border Margin="16"
            Padding="18"
            Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="DialogTitleText" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Height="2" Width="56" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <TextBlock x:Name="PromptText" TextWrapping="Wrap" Opacity="0.82"/>
            </StackPanel>

            <TextBlock x:Name="PrimaryLabelText" Grid.Row="1" Text="{DynamicResource PasswordLabel}" Style="{StaticResource DialogLabelStyle}"/>
            <PasswordBox x:Name="PasswordBox1" Grid.Row="2" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

            <StackPanel x:Name="ConfirmGroup" Grid.Row="3">
                <TextBlock x:Name="ConfirmLabelText" Text="{DynamicResource ConfirmPasswordLabel}" Style="{StaticResource DialogLabelStyle}"/>
                <PasswordBox x:Name="PasswordBox2" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#FFD64545" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PlainButton"
                        Content="{DynamicResource ExportPlainButton}"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        Click="OnPlainClick"/>
                <Button Content="{DynamicResource Cancel}"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        Click="OnCancelClick"/>
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource AccentDialogButton}"
                        Click="OnConfirmClick"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
