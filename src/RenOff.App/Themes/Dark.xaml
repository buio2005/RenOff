<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3A6EA5"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FF242424"/>

    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FF242424"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FF202020"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FF2A2A2A"/>

    <!-- Shared accents for list rows and secondary text -->
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#FFA0A0A0"/>
    <SolidColorBrush x:Key="ListItemHoverBackgroundBrush" Color="#FF2F2F2F"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#FF2B3A49"/>
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FF5A8CC7"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3A6EA5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF343434"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF3A3A3A"/>

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type Control}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="SelectionBrush" Value="#FF3A6EA5"/>
    </Style>

    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>
</ResourceDictionary>
