<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF7F1E6"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FF2A1F14"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFBF5"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#FF2A1F14"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFC9B89B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFB35A1F"/>

    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF2C999" Offset="0"/>
        <GradientStop Color="#FFE4B06D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF6D3A8" Offset="0"/>
        <GradientStop Color="#FFEAB778" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonPressedBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE6B777" Offset="0"/>
        <GradientStop Color="#FFD79A52" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#FF8B8075"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FFF0E9DD"/>

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE9D3B0" Offset="0"/>
        <GradientStop Color="#FFF7F1E6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFBF4E9"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFCF7"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFF6E8"/>

    <!-- Shared accents for list rows and secondary text -->
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#FF8A7A63"/>
    <SolidColorBrush x:Key="ListItemHoverBackgroundBrush" Color="#FFF1E6D2"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#FFF6E2C6"/>
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE1D3B8"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FFB35A1F"/>

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type Control}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

</ResourceDictionary>
