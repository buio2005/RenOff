<Window x:Class="RenOff.App.AppLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RenOff"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="AccentDialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
    </Window.Resources>
    <Border Margin="16"
            Padding="20"
            Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource AppLockTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Grid.Row="1" Height="2" Width="56" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <TextBlock Grid.Row="2" Text="{DynamicResource AppLockPrompt}" TextWrapping="Wrap" Opacity="0.82" Margin="0,0,0,12"/>
            <TextBlock Grid.Row="3" Text="{DynamicResource PasswordLabel}" Opacity="0.75" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="4" Height="34" VerticalContentAlignment="Center" KeyDown="OnPasswordKeyDown"/>
            <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="#FFD64545" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>

            <DockPanel Grid.Row="6" Margin="0,14,0,0" LastChildFill="False">
                <TextBlock VerticalAlignment="Center">
                    <Hyperlink Click="OnForgotClick">
                        <Run Text="{DynamicResource AppLockForgot}"/>
                    </Hyperlink>
                </TextBlock>
                <Button Content="{DynamicResource UnlockButton}"
                        Style="{StaticResource AccentDialogButton}"
                        Click="OnUnlockClick"
                        IsDefault="True"
                        DockPanel.Dock="Right"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
