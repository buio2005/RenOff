<Window x:Class="RenOff.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenOff.App"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}" Height="650" Width="998" MinHeight="520" MinWidth="820"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AccentBrush}"
                Background="{DynamicResource ChromeBackgroundBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding HeaderStatusMessage}"
                           VerticalAlignment="Center"
                           Opacity="0.75"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           MinWidth="90"/>
                <Button DockPanel.Dock="Right" Content="{DynamicResource DeleteAll}" Command="{Binding DeleteAllCommand}" Padding="10,6" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Delete}" Command="{Binding DeleteCommand}" Padding="10,6" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Add}" Command="{Binding AddCommand}" Padding="10,6" Margin="8,0,0,0"/>
                <Grid>
                    <TextBox x:Name="QuickAddTextBox"
                             Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Padding="10,0"
                             Background="{DynamicResource EditorBackgroundBrush}"
                             ToolTip="{DynamicResource QuickAddTooltip}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Text="{DynamicResource QuickAddPlaceholder}"
                               Margin="14,0,10,0"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ElementName=QuickAddTextBox, Path=Text}" Value=""/>
                                            <Condition Binding="{Binding ElementName=QuickAddTextBox, Path=IsKeyboardFocusWithin}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Background="{DynamicResource SidebarBackgroundBrush}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Padding="6" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource AccentBrush}"
                            Background="{DynamicResource SidebarBackgroundBrush}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{DynamicResource SelectAll}"
                                      IsChecked="{Binding BulkSelectAll}"
                                      VerticalAlignment="Center"
                                      Margin="6,0,10,0"/>
                            <Button Content="{DynamicResource CompleteSelected}" Command="{Binding CompleteSelectedCommand}" Padding="10,6" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource DeleteSelected}" Command="{Binding DeleteSelectedCommand}" Padding="10,6"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="ItemsListBox"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             BorderThickness="0"
                             Margin="0"
                             Padding="6"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="ItemsListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ItemsListBox_PreviewMouseMove"
                             DragOver="ItemsListBox_DragOver"
                             Drop="ItemsListBox_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="6" LastChildFill="True">
                                    <CheckBox DockPanel.Dock="Left"
                                              Width="18"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              IsChecked="{Binding IsBulkSelected}"/>

                                    <CheckBox DockPanel.Dock="Left"
                                              Width="22"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsDone}"
                                              IsEnabled="{Binding IsTodo}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTodo}" Value="False">
                                                        <Setter Property="Opacity" Value="0.25"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Type}" FontSize="11" Opacity="0.55"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <TabControl Grid.Column="1" Margin="10,10,10,10"
                        Background="{DynamicResource SurfaceBackgroundBrush}">
                <TabItem Header="{DynamicResource Details}">
                    <ContentControl Content="{Binding SelectedItem}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBox Grid.Row="0"
                                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="18"
                                                         FontWeight="SemiBold"
                                                         Padding="10,8"
                                                         Background="{DynamicResource EditorBackgroundBrush}"
                                                         Height="44"
                                                         VerticalContentAlignment="Center"/>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                                                    <CheckBox Content="{DynamicResource IsTodo}" IsChecked="{Binding IsTodo}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                    <CheckBox Content="{DynamicResource Completed}" IsChecked="{Binding IsDone}" IsEnabled="{Binding IsTodo}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Border Grid.Row="2" Padding="10" BorderThickness="1" CornerRadius="8"
                                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                                        Background="{DynamicResource SurfaceBackgroundBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  Content="{DynamicResource Reminder}"
                                                                  IsChecked="{Binding DataContext.ReminderEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,10,0"/>

                                                        <DatePicker Grid.Column="1"
                                                                    SelectedDate="{Binding DataContext.ReminderDate, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    IsEnabled="{Binding DataContext.ReminderEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Width="140"
                                                                    Margin="0,0,10,0"/>

                                                        <TextBox Grid.Column="2"
                                                                 Text="{Binding DataContext.ReminderTimeText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsEnabled="{Binding DataContext.ReminderEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 Width="70"
                                                                 Height="28"
                                                                 VerticalContentAlignment="Center"
                                                                 Padding="8,0"
                                                                 Margin="0,0,10,0"/>

                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding DataContext.CurrentLocalTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="0.85"/>

                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding DataContext.StatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="0.65"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <Button Grid.Column="5"
                                                                Content="{DynamicResource Save}"
                                                                Command="{Binding DataContext.SaveReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Padding="10,6"
                                                                Margin="0,0,8,0"/>

                                                        <Button Grid.Column="6"
                                                                Content="{DynamicResource Snooze10m}"
                                                                Command="{Binding DataContext.SnoozeSelectedReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Padding="10,6"
                                                                Margin="0,0,8,0"/>

                                                        <Button Grid.Column="7"
                                                                Content="{DynamicResource Disable}"
                                                                Command="{Binding DataContext.ClearReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Padding="10,6"/>
                                                    </Grid>
                                                </Border>

                                                <TextBox Grid.Row="3"
                                                         Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         TextWrapping="Wrap"
                                                         Padding="10,8"
                                                         Background="{DynamicResource EditorBackgroundBrush}"
                                                         Margin="0,10,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBlock Text="{DynamicResource SelectItemHint}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Opacity="0.6"
                                                                   FontSize="14"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </TabItem>

                <TabItem Header="{DynamicResource Settings}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Language}" VerticalAlignment="Center" Opacity="0.75"/>
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding UiLanguage}"
                                      SelectedValuePath="Tag"
                                      Height="30"
                                      Background="{DynamicResource EditorBackgroundBrush}"
                                      Foreground="{DynamicResource ControlForegroundBrush}"
                                      BorderBrush="{DynamicResource ControlBorderBrush}">
                                <ComboBoxItem Content="Italiano" Tag="it"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                            </ComboBox>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Theme}" VerticalAlignment="Center" Opacity="0.75"/>
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding UiTheme}"
                                      SelectedValuePath="Tag"
                                      Height="30"
                                      IsEnabled="{Binding IsThemeSelectionEnabled}"
                                      Background="{DynamicResource EditorBackgroundBrush}"
                                      Foreground="{DynamicResource ControlForegroundBrush}"
                                      BorderBrush="{DynamicResource ControlBorderBrush}">
                                <ComboBoxItem Content="Light" Tag="light"/>
                                <ComboBoxItem Content="Dark" Tag="dark"/>
                            </ComboBox>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource UiStyle}" VerticalAlignment="Center" Opacity="0.75"/>
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding UiStyle}"
                                      SelectedValuePath="Tag"
                                      Height="30"
                                      Background="{DynamicResource EditorBackgroundBrush}"
                                      Foreground="{DynamicResource ControlForegroundBrush}"
                                      BorderBrush="{DynamicResource ControlBorderBrush}">
                                <ComboBoxItem Content="{DynamicResource Classic}" Tag="classic"/>
                                <ComboBoxItem Content="{DynamicResource Modern}" Tag="modern"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox Grid.Row="3" Content="{DynamicResource CloseToTray}" IsChecked="{Binding CloseToTrayEnabled}" Margin="0,0,0,12"/>

                        <Grid Grid.Row="4" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Content="{DynamicResource Nudge}" IsChecked="{Binding NudgeEnabled}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource NudgeEvery}" VerticalAlignment="Center" Margin="10,0,10,0" Opacity="0.75"/>
                            <ComboBox Grid.Column="2"
                                      SelectedValue="{Binding NudgeIntervalHours}"
                                      SelectedValuePath="Tag"
                                      Height="30"
                                      Width="80"
                                      IsEnabled="{Binding NudgeEnabled}"
                                      Background="{DynamicResource EditorBackgroundBrush}"
                                      Foreground="{DynamicResource ControlForegroundBrush}"
                                      BorderBrush="{DynamicResource ControlBorderBrush}">
                                <ComboBoxItem Content="2" Tag="2"/>
                                <ComboBoxItem Content="4" Tag="4"/>
                                <ComboBoxItem Content="6" Tag="6"/>
                                <ComboBoxItem Content="12" Tag="12"/>
                            </ComboBox>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Hours}" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.75"/>
                        </Grid>

                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="{DynamicResource Export}" Command="{Binding ExportCommand}" Padding="10,6" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource Import}" Command="{Binding ImportCommand}" Padding="10,6"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
